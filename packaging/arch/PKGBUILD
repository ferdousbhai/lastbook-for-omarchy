# Maintainer: Ferdous Bhai <https://github.com/ferdousbhai>
# Built from the committed source, natively on each architecture:  cd packaging/arch && makepkg -s
pkgname=lastbook-for-omarchy
_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
_version=$(cat "$_root/VERSION")
_python=3.14                  # the wheels below are built for this Python; a new Arch Python needs new wheels
pkgver=$_version
pkgrel=1
pkgdesc='Offline survival library for Omarchy: manuals, videos, encyclopedias and offline maps, with a CLI and agent skill'
arch=('x86_64' 'aarch64')
url='https://github.com/ferdousbhai/lastbook-for-omarchy'
license=('MIT')
# The engine is Python (numpy, Beautiful Soup, and the two wheels below); the window is GTK 4 (native/), with WebKitGTK 6 for
# articles, Poppler for PDFs and GStreamer for videos: H.264/AAC through gst-libav, VP9 through gst-plugins-good, AV1 through gst-plugin-dav1d.
depends=('python>=3.14' 'python<3.15' 'python-numpy' 'python-beautifulsoup4' 'glib2' 'gtk4' 'webkitgtk-6.0' 'poppler-glib'
  'gstreamer' 'gst-plugins-base' 'gst-plugins-good' 'gst-libav' 'gst-plugin-dav1d' 'sqlite' 'gcc-libs')
optdepends=('recall-for-omarchy: meaning-based search, with the embedding model Recall already runs')
makedepends=('git' 'rust' 'gcc' 'pkgconf' 'python-pillow' 'binutils')
options=('!debug' '!lto' '!strip')
# Not in the Arch repositories: the ZIM reader and PDFium's bindings, as published on PyPI (pinned files, checked here).
# libzim stays below 4: 4.0.0 renamed getResults and getEstimatedMatches, which engine/library.py calls. pypdfium2's
# bitmap.to_numpy() is why the engine needs numpy (server.py draws PDF pages through it).
source_x86_64=("https://files.pythonhosted.org/packages/31/f3/16820fa6041ecbf6c6b54d1b3dcc23e3489f71447870f36a3d2779092434/libzim-3.13.1-cp314-cp314-manylinux_2_27_x86_64.manylinux_2_28_x86_64.whl"
  "https://files.pythonhosted.org/packages/4f/a3/c9cc797fc8bdfb8f37b9b0f8b9d02a5fc196b2015f408d53624cab5b0519/pypdfium2-5.14.0-py3-none-manylinux_2_17_x86_64.manylinux2014_x86_64.whl")
sha256sums_x86_64=('bc29b54e91690de33706d765605d3ca9a63e066ce70175f51bf1169ba63bef70'
  '11f281613fa22313d9c7ab89947665e84eccf8ebe40e1198a84a88352305648d')
source_aarch64=("https://files.pythonhosted.org/packages/b6/98/08ce16f4e3d6ec20a8c775272943efda63cd077ef9ebd0e64b83df544f9c/libzim-3.13.1-cp314-cp314-manylinux_2_27_aarch64.manylinux_2_28_aarch64.whl"
  "https://files.pythonhosted.org/packages/92/b4/0c31aa51887cd6cd032191dfe010a6d01ed43cf03204cfbd2184ebe4b715/pypdfium2-5.14.0-py3-none-manylinux_2_17_aarch64.manylinux2014_aarch64.whl")
sha256sums_aarch64=('77864105f08cceaf8ad3c9d7d4a9cc682a33b4962ac0ee1c31976e5330b24dc8'
  'f1b696e6901e16f114a2ec6332e5e3f8f5033a901614ead28499ab18ca6024f5')
noextract=("${source_x86_64[@]##*/}" "${source_aarch64[@]##*/}")

prepare() {
  rm -rf "$srcdir/lastbook"
  mkdir -p "$srcdir/lastbook"
  git -C "$_root" archive HEAD | tar -x -C "$srcdir/lastbook"
  cargo fetch --locked --manifest-path "$srcdir/lastbook/native/Cargo.toml"
  [ "$(python -c 'import sys; print("%d.%d" % sys.version_info[:2])')" = "$_python" ] || { echo "Python is not $_python: update the wheels" >&2; return 1; }
}

build() {
  cd "$srcdir/lastbook"
  # The window: native/, Rust and GTK 4. It runs the engine (app/engine_pipe.py) as its child, over pipes.
  # No build folder or home folder in the program: source paths in panic messages are remapped.
  RUSTFLAGS="$RUSTFLAGS --remap-path-prefix=$srcdir=/build --remap-path-prefix=${CARGO_HOME:-$HOME/.cargo}=/cargo" \
    CARGO_TARGET_DIR="$srcdir/target" cargo build --release --locked --manifest-path native/Cargo.toml
}

package() {
  cd "$srcdir/lastbook"
  local lib="$pkgdir/usr/lib/$pkgname"
  install -d "$lib/app" "$lib/engine/setup" "$lib/setup" "$lib/lib"
  # app/cli.py answers `lastbook COMMAND`; the skill (also inside the program, for `lastbook skill`) tells agents how to use it.
  install -m644 app/engine_pipe.py app/main.py app/bridge.py app/cli.py "$lib/app/"
  install -Dm644 skills/lastbook/SKILL.md "$lib/skills/lastbook/SKILL.md"
  install -m644 server.py retrieval.py encyclopedia.py VERSION "$lib/"
  install -m644 engine/__init__.py engine/paths.py engine/library.py engine/saved_pages.py engine/map_pois.py "$lib/engine/"
  install -m644 engine/setup/*.py engine/setup/roots.pem "$lib/engine/setup/"
  install -m644 packaging/arch/manifest-v1.json packaging/arch/map-regions.json "$lib/setup/"
  # The guides and nothing else of content/ (scan_package.py checks that).
  install -d "$lib/content/topics"
  install -m644 content/gaps.json "$lib/content/"
  install -m644 content/topics/*.json "$lib/content/topics/"
  local whl
  for whl in "$srcdir"/*.whl; do
    python -I -m zipfile -e "$(realpath "$whl")" "$lib/lib"
  done
  find "$lib/lib" -depth \( -name tests -o -name testing -o -name __pycache__ -o -name pypdfium2_cli \) -type d -exec rm -rf {} +
  python -I -m compileall -q -j 0 -s "$pkgdir" -p / "$lib" >/dev/null

  install -Dm755 "$srcdir/target/release/lastbook" "$pkgdir/usr/bin/lastbook"
  # One name, as Omarchy has it: the command, the desktop entry, the icon and the window's app id are all `lastbook`.
  install -Dm644 packaging/linux/lastbook.desktop "$pkgdir/usr/share/applications/lastbook.desktop"
  # The meaning-search indexer as a user service (`lastbook index`), on for every user through the drop-in: no symlink, nothing to enable.
  install -Dm644 packaging/systemd/lastbook-index.service "$pkgdir/usr/lib/systemd/user/lastbook-index.service"
  install -Dm644 packaging/systemd/lastbook-index.path "$pkgdir/usr/lib/systemd/user/lastbook-index.path"
  install -Dm644 packaging/systemd/default.target.d/lastbook-index.conf "$pkgdir/usr/lib/systemd/user/default.target.d/lastbook-index.conf"
  # The icon exists only as a 1024-pixel picture (packaging/icon/tile-1024.png), with no vector source to install as
  # scalable/apps/*.svg, so each size a launcher asks for is made from it here.
  python -I - packaging/icon/tile-1024.png "$pkgdir/usr/share/icons/hicolor" <<'PY'
import sys
from pathlib import Path
from PIL import Image
src, out = Image.open(sys.argv[1]).convert('RGBA'), Path(sys.argv[2])
for n in (16, 24, 32, 48, 64, 128, 256, 512):
    d = out / f'{n}x{n}' / 'apps'
    d.mkdir(parents=True, exist_ok=True)
    src.resize((n, n), Image.LANCZOS).save(d / 'lastbook.png', optimize=True)
PY
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 THIRD_PARTY_NOTICES.md "$pkgdir/usr/share/licenses/$pkgname/THIRD_PARTY_NOTICES.md"
}
