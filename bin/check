#!/usr/bin/env bash
# Every check a release must pass, run on this machine: the tests (bin/test, which also checks that native/Cargo.toml has
# VERSION's version), then `bash -n` on the scripts, install.sh's shared add_signed_repo hash and install.sh itself
# against stubbed pacman (tests/install_test.sh).
set -euo pipefail
cd "$(dirname "$0")/.."
bin/test
tests/install_test.sh

printf '\nAll checks passed.\n'
