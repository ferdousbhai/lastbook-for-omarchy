#!/usr/bin/env bash
# Release one version: bump, check, tag, build natively in CI on both architectures, sign locally, publish.
# Usage: bin/release <major.minor.patch>   (write packaging/release-notes.md for that version first)
# The first release is the version already in VERSION; later ones must be newer.
set -euo pipefail
cd "$(dirname "$0")/.."
command -v cargo >/dev/null || export PATH="$HOME/.cargo/bin:$PATH"
source packaging/arch/PKGBUILD
[[ $# == 1 && $1 =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo 'Usage: bin/release <major.minor.patch>' >&2; exit 1; }
version=$1 tag=v$1
[[ $(vercmp "$version" "$pkgver") -ge 0 ]] || { echo "Choose a version no older than $pkgver." >&2; exit 1; }
[[ -z $(git status --porcelain) ]] || { echo 'Commit your changes first.' >&2; exit 1; }
gh_repo=${url#https://github.com/}
remote=$(git remote -v | awk -v repo="$gh_repo" '$3 == "(push)" && $2 ~ ("github\\.com[:/]" repo "(\\.git)?$") { print $1; exit }')
[[ -n $remote ]] || { echo "No git remote points at $gh_repo." >&2; exit 1; }
git fetch -q "$remote" main --tags
# Resuming at the tag after main moved on is fine as long as main already holds the tag.
tag_at_head() { [[ $(git rev-parse -q --verify "refs/tags/$tag^{commit}") == $(git rev-parse HEAD) ]]; }
git merge-base --is-ancestor "$remote/main" HEAD || { tag_at_head && git merge-base --is-ancestor HEAD "$remote/main"; } \
  || { echo "HEAD does not contain $remote/main; rebase first." >&2; exit 1; }
# Releases are made from main (or, resuming, from the tag itself): pushing another branch here would move main to it.
[[ $(git branch --show-current) == main ]] || tag_at_head \
  || { echo "Release from main." >&2; exit 1; }
# This tag's releases on GitHub, one line each: "true" for a draft, "false" for a published one.
release_states() { gh api "repos/$gh_repo/releases" --paginate --jq ".[] | select(.tag_name == \"$tag\") | .draft"; }
# A run that failed after tagging (the CI build, the watch, signing, the upload) is resumed by running this again on
# the same commit: nothing is bumped or tagged twice, and a finished or running CI build is reused.
resume=0
if git rev-parse -q --verify "refs/tags/$tag" >/dev/null; then
  if [[ $(git rev-parse "$tag^{commit}") != "$(git rev-parse HEAD)" || $(cat VERSION) != "$version" ]]; then
    echo "$tag already exists and is not this commit. Choose a newer version; or, if $tag was never published," >&2
    echo "delete the tag here and on $remote, then run this again. To resume $tag after main moved on:" >&2
    echo "git checkout $tag && bin/release $version" >&2
    exit 1
  fi
  states=$(release_states)
  ! grep -qx false <<< "$states" || { echo "$tag is already published." >&2; exit 1; }
  resume=1
  echo "Resuming the release of $tag."
fi
grep -qF "$tag" packaging/release-notes.md || { echo "Write packaging/release-notes.md for $tag first." >&2; exit 1; }
fingerprint=$(sed -n 's/^SIGNING_KEY_FINGERPRINT=//p' install.sh)
gpg --batch --list-secret-keys "$fingerprint" >/dev/null
export GPGKEY=$fingerprint
if (( ! resume )); then
  # Setup's pinned roots must still cover every download host. It needs the network, so it runs here and not in bin/check.
  python3 -I -B packaging/check_tls_roots.py

  echo "$version" > VERSION
  sed -i "0,/^version = .*/s//version = \"$version\"/" native/Cargo.toml
  cargo update --workspace --offline --manifest-path native/Cargo.toml
  bin/check
  # Named paths only: other work in this checkout stays out of the release commit.
  if ! git diff --quiet -- VERSION native/Cargo.toml native/Cargo.lock; then
    git commit -q -m "Release $tag" -- VERSION native/Cargo.toml native/Cargo.lock
  fi
  [[ -z $(git status --porcelain) ]] || { echo 'The checks left changes behind; nothing was tagged.' >&2; exit 1; }
  git tag -a "$tag" -m "Lastbook for Omarchy $version"
fi
source_commit=$(git rev-parse HEAD)
# workflow_dispatch runs only workflows that exist on the default branch, so main gets the release commit first.
# Both or neither; when resuming, this changes nothing that is already there.
if git merge-base --is-ancestor HEAD "$remote/main"; then
  git push -q "$remote" "$tag"                       # main has it already (a resume after main moved on)
else
  git push -q --atomic "$remote" HEAD:main "$tag"
fi
# This tag and commit's builds, newest first, as the jq filter given picks from them.
find_run() {
  gh run list --repo "$gh_repo" --workflow packages.yml --event workflow_dispatch \
    --branch "$tag" --commit "$source_commit" --limit 20 --json databaseId,status,conclusion --jq "$1"
}
run_id=''
if (( resume )); then   # a build that passed, else one still running
  run_id=$(find_run '[.[] | select(.conclusion == "success")][0].databaseId // empty')
  [[ -n $run_id ]] || run_id=$(find_run '[.[] | select(.status != "completed")][0].databaseId // empty')
fi
if [[ -z $run_id ]]; then
  newest=$(find_run '[.[].databaseId] | max // 0')
  gh workflow run packages.yml --repo "$gh_repo" --ref "$tag"
  for _ in {1..60}; do
    run_id=$(find_run "[.[] | select(.databaseId > $newest)][0].databaseId // empty")
    [[ -z $run_id ]] || break
    sleep 10
  done
fi
[[ -n $run_id ]] || { echo "Native CI did not start. Run bin/release $version again to resume." >&2; exit 1; }
gh run watch "$run_id" --repo "$gh_repo" --exit-status \
  || { echo "Native CI failed or could not be watched; no release was published. Inspect run $run_id." >&2
       echo "If the build passed or is still running, run bin/release $version again to resume." >&2; exit 1; }
# Revalidate the completed run, not just its search result or filename.
run_valid=$(gh run view "$run_id" --repo "$gh_repo" \
  --json headSha,headBranch,event,status,conclusion \
  --jq ".headSha == \"$source_commit\" and .headBranch == \"$tag\" and .event == \"workflow_dispatch\" and .status == \"completed\" and .conclusion == \"success\"")
[[ $run_valid == true ]] || { echo "CI run provenance/status mismatch; not signing." >&2; exit 1; }
artifacts=$(mktemp -d)
trap 'rm -rf "$artifacts"' EXIT
gh run download "$run_id" --repo "$gh_repo" --dir "$artifacts"
rm -rf dist/release
bin/collect-packages "$artifacts" "$source_commit" dist/release "$version-$pkgrel"
for package in dist/release/*.pkg.tar.zst; do
  gpg --local-user "$fingerprint" --detach-sign --output "$package.sig" "$package"
  gpg --verify "$package.sig" "$package"
done
(
  cd dist/release
  for architecture in "${arch[@]}"; do
    name=$pkgname
    [[ $architecture == x86_64 ]] || name+=-aarch64
    repo-add --sign --verify "$name.db.tar.gz" ./*-"$architecture.pkg.tar.zst"
    for suffix in db files; do
      rm -f "$name.$suffix" "$name.$suffix.sig"
      cp "$name.$suffix.tar.gz" "$name.$suffix"
      cp "$name.$suffix.tar.gz.sig" "$name.$suffix.sig"
    done
    gpg --batch --armor --export "$fingerprint" >"$name-signing-key.asc"
  done
  cp ../../install.sh install.sh
)

# A draft left behind by an upload that failed is replaced, never published as it is; the tag stays.
while states=$(release_states); grep -qx true <<< "$states"; do
  gh release delete "$tag" --repo "$gh_repo" --yes
done
gh release create "$tag" dist/release/* --repo "$gh_repo" --title "Lastbook for Omarchy $tag" \
  --notes-file packaging/release-notes.md --verify-tag --latest
echo "Published https://github.com/$gh_repo/releases/tag/$tag; installation verification runs in CI."
echo "It checks that https://ferdousbhai.com/lastbook/install.sh is this release's install.sh: publish it there first."
echo "If that was late: gh workflow run verify-release.yml -f release_tag=$tag"
