#!/usr/bin/env bash
# The tests a change must pass, without a library: the window's (cargo test, then its main flows driven by the scripts
# in native/dev/qa over a made-up library, on a broadway display of their own) and the engine's (README, Tests).
set -euo pipefail
cd "$(dirname "$0")/.."
# One version everywhere: native/Cargo.toml's is VERSION.
version=$(cat VERSION)
[[ $(sed -n '0,/^version = /s/^version = "\(.*\)"/\1/p' native/Cargo.toml) == "$version" ]] \
  || { echo "native/Cargo.toml's version is not $version (VERSION)" >&2; exit 1; }
command -v cargo >/dev/null || export PATH="$HOME/.cargo/bin:$PATH"
cargo test --locked --manifest-path native/Cargo.toml
# Feature `qa` only here: release builds leave it off.
cargo build --locked --features qa --manifest-path native/Cargo.toml
for script in native/dev/qa/*.jsonl; do
  # Each command and its answer only when the run fails.
  out=$(native/dev/qa.sh "$script" 2>&1) || { printf '%s\n' "$out" >&2; exit 1; }
  printf '%s\n' "${out##*$'\n'}"
done
# Every app/tests/test_*.py, as the module app.tests.<name>.
tests=(app/tests/test_*.py)
tests=("${tests[@]%.py}")
PYTHONPATH=$(bin/test-deps) python3 -B -m unittest "${tests[@]//\//.}"
