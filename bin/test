#!/usr/bin/env bash
# The tests a change must pass, without a library: the window's (cargo test) and the engine's (README, Tests).
set -euo pipefail
cd "$(dirname "$0")/.."
command -v cargo >/dev/null || export PATH="$HOME/.cargo/bin:$PATH"
cargo test --locked --manifest-path native/Cargo.toml
PYTHONPATH=$(bin/test-deps) python3 -B -m unittest app.tests.test_bridge app.tests.test_setup app.tests.test_data_folder \
  app.tests.test_what_ships app.tests.test_address_search app.tests.test_topic_search app.tests.test_validate_topics \
  app.tests.test_libq app.tests.test_semantic
