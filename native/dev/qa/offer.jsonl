# The map offer: the computer's weather location in Omarchy (Testville, set by the stand-in engine offer.engine) has no
# street map, so the window asks as it opens. Two regions' boxes hold Testville, so the dialog lists both; one is
# chosen and one press downloads it (the stand-in makes the download up), shown in Library and downloads. The switch
# there turns the offer off, and its suggestion goes.
# native/dev/qa.sh native/dev/qa/offer.jsonl [shots-dir]

{"do":"wait","role":"window","name":"Guides — Lastbook","timeout_ms":30000}
{"do":"wait","dialog":"Add a street map for Testville?"}
{"do":"wait","role":"radio","name":"Ethiopia","checked":true}
{"do":"click","role":"radio","name":"Sudan"}
{"do":"wait","role":"radio","name":"Sudan","checked":true}
{"do":"shot","path":"offer.png"}
{"do":"click","role":"button","name":"Download"}
{"do":"wait","dialog":null}
{"do":"wait","role":"window","name":"Library and downloads — Lastbook"}
{"do":"wait","role":"label","name":"Streets for Sudan — Downloading · 40 MB of 120 MB · 2 MB/s · about 1 minute left","visible":true}
{"do":"wait","role":"button","name":"Pause","visible":true}
{"do":"shot","path":"offer-downloading.png"}
{"do":"click","role":"button","name":"Pause"}
{"do":"wait","role":"button","name":"Resume","visible":true}
{"do":"quit"}
