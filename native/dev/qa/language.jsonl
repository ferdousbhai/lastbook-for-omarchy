# The language and the keys' overlay: the window follows a switch of language while it runs (omui's `language`
# command does what Omarchy's language file does, and dev/qa/da.json, built into the QA window, is a few Danish strings
# for it), and `?` and F1 list every
# shortcut, `?` only while no text field has the keyboard.
# native/dev/qa.sh native/dev/qa/language.jsonl [shots-dir]

{"do":"wait","role":"window","name":"Guides — Lastbook","timeout_ms":30000}
{"do":"wait","role":"grid-cell","name":"Get safe drinking water","visible":true}

# A switch: the sidebar, the footer, the header's buttons and the screen on show, at once, and back again.
{"do":"language","code":"da"}
{"do":"wait","role":"window","name":"Vejledninger — Lastbook"}
{"do":"wait","role":"list-item","name":"Bibliotek","visible":true}
{"do":"wait","role":"label","name":"Virker uden net","visible":true}
{"do":"wait","role":"button","name":"Tilbage (Alt+Venstre)","visible":true}
{"do":"shot","path":"danish.png"}
{"do":"select","role":"list-item","name":"Bibliotek"}
{"do":"wait","role":"window","name":"Bibliotek — Lastbook"}
{"do":"language","code":"en"}
{"do":"wait","role":"window","name":"Library — Lastbook"}
{"do":"wait","role":"list-item","name":"Guides","visible":true}
{"do":"wait","role":"button","name":"Back (Alt+Left)","visible":true}

# `?` opens the shortcuts, Escape closes them; F1 opens and closes them too.
{"do":"key","keys":"question"}
{"do":"wait","dialog":"Keyboard shortcuts"}
{"do":"wait","role":"label","name":"Fit the page to the window's width","visible":true}
{"do":"shot","path":"shortcuts.png"}
{"do":"key","keys":"Escape"}
{"do":"wait","dialog":null}
{"do":"key","keys":"F1"}
{"do":"wait","dialog":"Keyboard shortcuts"}
{"do":"key","keys":"F1"}
{"do":"wait","dialog":null}

# In the search field `?` is a character typed; F1 still opens the list.
{"do":"key","keys":"<Control>f"}
{"do":"wait","role":"window","name":"Search — Lastbook"}
{"do":"key","keys":"question"}
{"do":"wait","role":"search-box","name":"What do you need? A word, a question, a model number…","text":"?"}
{"do":"wait","dialog":null}
{"do":"key","keys":"F1"}
{"do":"wait","dialog":"Keyboard shortcuts"}
{"do":"key","keys":"Escape"}
{"do":"wait","dialog":null}
{"do":"quit"}
