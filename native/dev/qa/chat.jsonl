# Chat with no local AI: a suggested question, a source of its answer opened, a question about that page typed and
# sent with Enter, a new chat, and the first chat again from the list.
# native/dev/qa.sh native/dev/qa/chat.jsonl [shots-dir]

{"do":"wait","role":"window","name":"Guides — Lastbook"}
{"do":"select","role":"list-item","name":"Chat"}
{"do":"wait","role":"window","name":"Chat — Lastbook"}
{"do":"wait","role":"button","name":"How do I make water safe to drink?","visible":true}
{"do":"shot","path":"chat-empty.png"}
{"do":"click","role":"button","name":"How do I make water safe to drink?"}
{"do":"wait","role":"label","name":"No local AI answered: here are the matching pages.","visible":true}
{"do":"wait","role":"list-item","name":"How do I make water safe to drink?","visible":true}
{"do":"wait","role":"generic","name":"Safe water at home, Preview Press · page 1 of 2","visible":true}
{"do":"shot","path":"chat.png"}

# A source opens on its page, and "Ask about this page" comes back to Chat about it.
{"do":"focus","role":"generic","name":"Safe water at home, Preview Press · page 1 of 2"}
{"do":"key","keys":"Return"}
{"do":"wait","role":"window","name":"Safe water at home — Lastbook"}
{"do":"wait","role":"text-box","name":"Page number","text":"1"}
{"do":"click","role":"button","name":"Ask about this page"}
{"do":"wait","role":"window","name":"Chat — Lastbook"}
{"do":"wait","role":"text-box","name":"Your question","focused":true}
{"do":"type","role":"text-box","name":"Your question","text":"how long do I boil it"}
{"do":"key","keys":"Return"}
{"do":"wait","role":"list-item","name":"how long do I boil it","visible":true}
{"do":"wait","role":"text-box","name":"Your question","text":""}
{"do":"shot","path":"chat-about-page.png"}

# A new chat starts empty; the first is still in the list, and opens again from it.
{"do":"click","role":"button","name":"New chat"}
{"do":"wait","role":"button","name":"How do I make water safe to drink?","visible":true}
{"do":"click","role":"list-item","name":"How do I make water safe to drink?"}
{"do":"wait","role":"label","name":"No local AI answered: here are the matching pages.","visible":true}
{"do":"wait","role":"button","name":"How do I make water safe to drink?","visible":false}
{"do":"quit"}
