# Every screen the sidebar and the footer reach, a picture of each, and what the keyboard does on them: the history,
# the sidebar's arrows, the reader's keys and its page field, a saved web page, and the drop-down of areas in the library's downloads.
# native/dev/qa.sh native/dev/qa/browse.jsonl [shots-dir]

# Guides, and a guide opened from its card.
{"do":"wait","role":"window","name":"Guides — Lastbook","timeout_ms":30000}
{"do":"wait","role":"grid-cell","name":"Get safe drinking water","visible":true}
{"do":"wait","role":"button","name":"Back (Alt+Left)","sensitive":false}
{"do":"shot","path":"guides.png"}
{"do":"click","role":"grid-cell","name":"Get safe drinking water"}
{"do":"wait","role":"window","name":"Get safe drinking water — Lastbook"}
{"do":"wait","role":"button","name":"Save this (Ctrl+D)","visible":true}
{"do":"shot","path":"guide.png"}

# Alt+Left goes back to the guides, Alt+Right forward to the guide again.
{"do":"key","keys":"<Alt>Left"}
{"do":"wait","role":"window","name":"Guides — Lastbook"}
{"do":"wait","role":"button","name":"Forward (Alt+Right)","sensitive":true}
{"do":"key","keys":"<Alt>Right"}
{"do":"wait","role":"window","name":"Get safe drinking water — Lastbook"}
{"do":"wait","role":"button","name":"Forward (Alt+Right)","sensitive":false}

# Down in the sidebar goes to the library and leaves the keyboard in the sidebar. A shelf, and a manual from it, by
# the keyboard.
{"do":"focus","role":"list-item","name":"Guides"}
{"do":"key","keys":"Down"}
{"do":"wait","role":"window","name":"Library — Lastbook"}
{"do":"wait","role":"list-item","name":"Library","selected":true,"focused":true}
{"do":"wait","role":"grid-cell","name":"Water & sanitation","visible":true}
{"do":"shot","path":"library.png"}
{"do":"focus","role":"grid-cell","name":"Water & sanitation"}
{"do":"key","keys":"Return"}
{"do":"wait","role":"window","name":"Water & sanitation — Lastbook"}
{"do":"shot","path":"shelf.png"}
{"do":"focus","role":"generic","name":"Safe water at home, PDF · Preview Press · 2 pages"}
{"do":"key","keys":"Return"}
{"do":"wait","role":"window","name":"Safe water at home — Lastbook"}
# The reader: no page before the first, none after the last. The page has the keyboard as it opens, so its keys work
# at once.
{"do":"wait","role":"img","name":"Page 1 of 2","focused":true}
{"do":"wait","role":"button","name":"Previous page (Left, Page Up)","sensitive":false}
{"do":"wait","role":"button","name":"Next page (Right, Page Down)","sensitive":true}
# Down and Up scroll within the page, which is taller than the window, and the keyboard stays on the page (Up at the
# top of a page is still the page's key, not a step to the toolbar above).
{"do":"key","keys":"Down"}
{"do":"key","keys":"Up"}
{"do":"key","keys":"Up"}
{"do":"wait","role":"img","name":"Page 1 of 2","focused":true}
# Space reads on: down this page first, and on to the next page only from its foot. Backspace reads back the same
# way: from the top of a page to the foot of the one before, then up it.
{"do":"key","keys":"space"}
{"do":"wait","role":"text-box","name":"Page number","text":"1"}
{"do":"key","keys":"space"}
{"do":"wait","role":"text-box","name":"Page number","text":"2"}
{"do":"key","keys":"BackSpace"}
{"do":"wait","role":"text-box","name":"Page number","text":"1"}
{"do":"key","keys":"BackSpace"}
{"do":"wait","role":"text-box","name":"Page number","text":"1"}
{"do":"key","keys":"Page_Down"}
{"do":"wait","role":"text-box","name":"Page number","text":"1"}
{"do":"key","keys":"Page_Down"}
{"do":"wait","role":"text-box","name":"Page number","text":"2"}
{"do":"key","keys":"Home"}
{"do":"wait","role":"text-box","name":"Page number","text":"1"}
{"do":"wait","role":"img","name":"Page 1 of 2","focused":true}
{"do":"key","keys":"Right"}
{"do":"wait","role":"text-box","name":"Page number","text":"2"}
{"do":"wait","role":"button","name":"Previous page (Left, Page Up)","sensitive":true}
{"do":"wait","role":"button","name":"Next page (Right, Page Down)","sensitive":false}
{"do":"shot","path":"reader.png"}
{"do":"key","keys":"Home"}
{"do":"wait","role":"text-box","name":"Page number","text":"1"}
{"do":"key","keys":"End"}
{"do":"wait","role":"text-box","name":"Page number","text":"2"}
{"do":"key","keys":"Page_Up"}
{"do":"wait","role":"text-box","name":"Page number","text":"1"}
{"do":"key","keys":"space"}
{"do":"wait","role":"text-box","name":"Page number","text":"2"}
{"do":"key","keys":"BackSpace"}
{"do":"wait","role":"text-box","name":"Page number","text":"1"}
# The button that turned to the last page is greyed under the keyboard, and the keys still turn pages.
{"do":"click","role":"button","name":"Next page (Right, Page Down)"}
{"do":"wait","role":"button","name":"Next page (Right, Page Down)","sensitive":false}
{"do":"key","keys":"Left"}
{"do":"wait","role":"text-box","name":"Page number","text":"1"}
# + and - zoom and 0 fits the width again: 776 pixels of page in the 1024 pixel window a broadway display gives.
{"do":"wait","role":"img","name":"Page 1 of 2","width":776}
{"do":"key","keys":"plus"}
{"do":"wait","role":"img","name":"Page 1 of 2","width":931}
{"do":"key","keys":"minus"}
{"do":"key","keys":"minus"}
{"do":"wait","role":"img","name":"Page 1 of 2","width":647}
{"do":"key","keys":"0"}
{"do":"wait","role":"img","name":"Page 1 of 2","width":776}
# A page number typed in the field, where the same keys are text.
{"do":"focus","role":"text-box","name":"Page number"}
{"do":"key","keys":"<Control>a"}
{"do":"type","text":"2"}
{"do":"key","keys":"Return"}
{"do":"wait","role":"img","name":"Page 2 of 2","visible":true}
{"do":"key","keys":"0"}
{"do":"wait","role":"text-box","name":"Page number","text":"02"}
{"do":"click","role":"button","name":"Back (Alt+Left)"}
{"do":"wait","role":"window","name":"Water & sanitation — Lastbook"}

# A saved web page opens in the web view under its own title, with its publisher above it, and Back leaves it.
{"do":"click","role":"button","name":"Back (Alt+Left)"}
{"do":"wait","role":"window","name":"Library — Lastbook"}
{"do":"focus","role":"grid-cell","name":"Other references"}
{"do":"key","keys":"Return"}
{"do":"wait","role":"window","name":"Other references — Lastbook"}
{"do":"focus","role":"generic","name":"Rope, Saved web page · Preview Press"}
{"do":"key","keys":"Return"}
{"do":"wait","role":"window","name":"Rope — Lastbook"}
{"do":"shot","path":"saved-page.png"}
{"do":"key","keys":"<Alt>Left"}
{"do":"wait","role":"window","name":"Other references — Lastbook"}

# Videos (the made-up library has none), the map (no map data in it), About and the library's downloads, unstarted.
{"do":"select","role":"list-item","name":"Videos"}
{"do":"wait","role":"window","name":"Videos — Lastbook"}
{"do":"wait","role":"search-box","name":"Search video titles","visible":true}
{"do":"shot","path":"videos.png"}
{"do":"select","role":"list-item","name":"Map"}
{"do":"wait","role":"window","name":"Map — Lastbook"}
{"do":"wait","role":"search-box","name":"Find a town, or LAT,LON","visible":true}
{"do":"click","role":"button","name":"Zoom in (+)"}
{"do":"shot","path":"map.png"}
{"do":"focus","role":"button","name":"About"}
{"do":"key","keys":"Return"}
{"do":"wait","role":"window","name":"About — Lastbook"}
{"do":"wait","role":"generic","name":"Privacy","visible":true}
{"do":"shot","path":"about.png"}
{"do":"focus","role":"generic","name":"Library and downloads"}
{"do":"key","keys":"Return"}
{"do":"wait","role":"window","name":"Library and downloads — Lastbook"}
{"do":"wait","role":"radio","name":"Keep the library as it is","checked":true}
{"do":"shot","path":"manage.png"}

# Streets for an area: the drop-down opens with Enter, Down and Enter pick the first area, which becomes a chip that a
# click removes; Escape closes the list with nothing picked. Nothing is downloaded: that is the Download button's.
{"do":"focus","role":"combo-box","name":"Add streets for an area"}
{"do":"key","keys":"Return"}
{"do":"wait","role":"list-item","name":"Afghanistan · Asia","visible":true}
{"do":"key","keys":"Down"}
{"do":"key","keys":"Return"}
{"do":"wait","role":"button","name":"Remove","visible":true}
{"do":"wait","role":"list-item","name":"Afghanistan · Asia","visible":false}
{"do":"click","role":"combo-box","name":"Add streets for an area"}
{"do":"wait","role":"list-item","name":"Afghanistan · Asia","visible":true}
{"do":"key","keys":"Escape"}
{"do":"wait","role":"list-item","name":"Afghanistan · Asia","visible":false}
{"do":"wait","role":"window","name":"Library and downloads — Lastbook"}
{"do":"click","role":"button","name":"Remove"}
{"do":"wait","role":"button","name":"Remove","visible":false}
{"do":"quit"}
